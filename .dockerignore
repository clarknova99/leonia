# Keep the build context small.
# Everything COPY'd into the image is whitelisted in webapp/Dockerfile.

# Python build artefacts
__pycache__/
*.pyc
*.pyo
*.pyd
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage*
htmlcov/

# Local venvs
venv/
.venv/
env/
.env

# IDE / editor
.vscode/
.idea/
*.swp
.DS_Store

# Git, docs, scratch — webapp doesn't read these at runtime
.git/
.gitignore
docs/
reports/
notebooks/
scripts/
tests/

# Heavy data — only the published serve set (data/webapp/) and the small
# borough polygon are COPY'd into the image. Exclude everything else under
# data/ (raw inputs, the staged parquet lake, the ~17 GB SUMO build tree).
data/raw/
data/stage-1/
data/stage-2/
data/sumo/
data/network/*
!data/network/leonia_borough.geojson

# Build artefacts
dist/
build/
*.egg-info/
